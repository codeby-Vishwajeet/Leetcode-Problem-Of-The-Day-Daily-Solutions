#include <vector>
#include <queue>
#include <algorithm>

using namespace std;

class Solution {
public:
    // Helper function for modular exponentiation: (base^exp) % mod
    long long power(long long base, long long exp) {
        long long res = 1;
        long long mod = 1e9 + 7;
        base %= mod;
        while (exp > 0) {
            if (exp % 2 == 1) res = (res * base) % mod;
            base = (base * base) % mod;
            exp /= 2;
        }
        return res;
    }

    // Renamed from countWays to assignEdgeWeights to match LeetCode's expected signature
    int assignEdgeWeights(vector<vector<int>>& edges) {
        int n = edges.size() + 1;
        vector<vector<int>> adj(n + 1);
        
        // Build the adjacency list for the tree
        for (const auto& edge : edges) {
            adj[edge[0]].push_back(edge[1]);
            adj[edge[1]].push_back(edge[0]);
        }
        
        int max_depth = 0;
        queue<pair<int, int>> q; // Stores {node, depth}
        vector<bool> visited(n + 1, false);
        
        q.push({1, 0});
        visited[1] = true;
        
        // BFS to find the maximum depth of the tree
        while (!q.empty()) {
            auto [node, depth] = q.front();
            q.pop();
            
            max_depth = max(max_depth, depth);
            
            for (int neighbor : adj[node]) {
                if (!visited[neighbor]) {
                    visited[neighbor] = true;
                    q.push({neighbor, depth + 1});
                }
            }
        }
        
        // The answer is simply 2^(max_depth - 1) modulo 10^9 + 7
        return power(2, max_depth - 1);
    }
};
