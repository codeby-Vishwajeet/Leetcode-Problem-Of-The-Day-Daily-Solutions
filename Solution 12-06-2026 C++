#include <vector>

using namespace std;

class Solution {
    int LOG;
    int MOD = 1e9 + 7;
    vector<vector<int>> up;
    vector<int> depth;
    
    // Precompute LCA table and depths
    void dfs(int u, int p, int d, const vector<vector<int>>& adj) {
        depth[u] = d;
        up[u][0] = p; // The 2^0 (1st) ancestor is the parent
        
        for (int i = 1; i < LOG; i++) {
            up[u][i] = up[up[u][i - 1]][i - 1];
        }
        
        for (int v : adj[u]) {
            if (v != p) {
                dfs(v, u, d + 1, adj);
            }
        }
    }
    
    // Find Lowest Common Ancestor using Binary Lifting
    int getLCA(int u, int v) {
        // Ensure u is deeper than v
        if (depth[u] < depth[v]) {
            swap(u, v);
        }
        
        // Equalize depths
        int diff = depth[u] - depth[v];
        for (int i = 0; i < LOG; i++) {
            if ((diff >> i) & 1) {
                u = up[u][i];
            }
        }
        
        if (u == v) return u;
        
        // Climb together
        for (int i = LOG - 1; i >= 0; i--) {
            if (up[u][i] != up[v][i]) {
                u = up[u][i];
                v = up[v][i];
            }
        }
        
        return up[u][0];
    }
    
    // Fast modular exponentiation
    long long modPow(long long base, long long exp) {
        long long res = 1;
        base %= MOD;
        while (exp > 0) {
            if (exp % 2 == 1) res = (res * base) % MOD;
            base = (base * base) % MOD;
            exp /= 2;
        }
        return res;
    }

public:
    vector<int> assignEdgeWeights(vector<vector<int>>& edges, vector<vector<int>>& queries) {
        int n = edges.size() + 1; // Since it's a tree, nodes = edges + 1
        vector<vector<int>> adj(n + 1);
        
        // Build adjacency list
        for (const auto& edge : edges) {
            adj[edge[0]].push_back(edge[1]);
            adj[edge[1]].push_back(edge[0]);
        }
        
        // Calculate max LOG needed for N nodes
        LOG = 0;
        while ((1 << LOG) <= n) {
            LOG++;
        }
        
        up.assign(n + 1, vector<int>(LOG, 0));
        depth.assign(n + 1, 0);
        
        // Root the tree arbitrarily at node 1
        dfs(1, 1, 0, adj);
        
        vector<int> ans;
        ans.reserve(queries.size());
        
        for (const auto& q : queries) {
            int u = q[0];
            int v = q[1];
            
            int lca = getLCA(u, v);
            int k = depth[u] + depth[v] - 2 * depth[lca]; // Number of edges in path
            
            if (k == 0) {
                ans.push_back(0);
            } else {
                ans.push_back(modPow(2, k - 1));
            }
        }
        
        return ans;
    }
};
