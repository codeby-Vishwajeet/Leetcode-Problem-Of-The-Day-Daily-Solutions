#include <vector>
#include <string>

using namespace std;

class Solution {
public:
    // Renamed to perfectly match LeetCode's expected function signature
    vector<int> sumAndMultiply(string s, vector<vector<int>>& queries) {
        int n = s.length();
        long long MOD = 1e9 + 7;
        
        // 1-based indexing prefix arrays
        vector<long long> pref_sum(n + 1, 0);
        vector<int> pref_nz(n + 1, 0);
        vector<long long> pref_val(n + 1, 0);
        vector<long long> pow10(n + 1, 1);
        
        // Precompute everything in a single pass
        for (int i = 1; i <= n; ++i) {
            int digit = s[i - 1] - '0';
            
            // Precompute powers of 10 modulo 10^9 + 7
            pow10[i] = (pow10[i - 1] * 10) % MOD;
            
            // Prefix sum of digits
            pref_sum[i] = pref_sum[i - 1] + digit;
            
            // Prefix count of non-zero digits
            pref_nz[i] = pref_nz[i - 1] + (digit > 0 ? 1 : 0);
            
            // Prefix value of concatenated non-zero digits
            if (digit > 0) {
                pref_val[i] = (pref_val[i - 1] * 10 + digit) % MOD;
            } else {
                pref_val[i] = pref_val[i - 1]; // Zeroes are ignored in concatenation
            }
        }
        
        vector<int> ans;
        ans.reserve(queries.size());
        
        // Answer each query in O(1) time
        for (const auto& q : queries) {
            int l = q[0];
            int r = q[1];
            
            // 1. Calculate sum of digits in range [l, r]
            long long sum = pref_sum[r + 1] - pref_sum[l];
            
            // 2. Calculate the number of non-zero digits in range [l, r]
            int k = pref_nz[r + 1] - pref_nz[l];
            
            // 3. Extract the integer 'x' for the subsegment
            long long x = (pref_val[r + 1] - (pref_val[l] * pow10[k]) % MOD) % MOD;
            
            // Handle negative values from modulo arithmetic in C++
            if (x < 0) {
                x += MOD;
            }
            
            // 4. Calculate the final answer modulo 10^9 + 7
            long long res = (x * (sum % MOD)) % MOD;
            ans.push_back(res);
        }
        
        return ans;
    }
};
